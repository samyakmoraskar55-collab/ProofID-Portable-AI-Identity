# ==============================================================================
# ProofID - Portable AI Identity Environment Configuration
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-proofid-dev-key-change-in-production-xyz123
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite for local dev; PostgreSQL-ready)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=proofid_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Monad Testnet & Smart Contract Settings
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
PROOF_ID_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
MONAD_CHAIN_ID=10143
MONAD_EXPLORER_URL=https://testnet.monadexplorer.com

# Deployer / Relayer Private Key (For on-chain anchoring transactions)
# DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# LLM API Keys (Optional - Trust Analyzer runs sophisticated heuristic engine if unset)
